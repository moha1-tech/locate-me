# Copy this file to .env.production and fill in real values before deploying.
# docker-compose.prod.yml reads POSTGRES_PASSWORD directly; everything else
# is passed straight through to the backend/caddy containers via env_file.

POSTGRES_PASSWORD="replace-with-a-long-random-password"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3010
GEOFENCE_CHECK_ENABLED=true

# Your free DuckDNS subdomain (e.g. locateme -> locateme.duckdns.org) and the
# token from your DuckDNS account page. Caddy uses these to prove domain
# ownership via DNS instead of needing port 80 open.
DUCKDNS_DOMAIN="locateme.duckdns.org"
DUCKDNS_TOKEN="replace-with-your-duckdns-token"

# Must be wss:// (not ws://) once behind Caddy's TLS termination. Port 48444
# is the reserved LiveKit signaling port (see Caddyfile) - NOT the default 7880.
LIVEKIT_URL="wss://locateme.duckdns.org:48444"
# These two MUST exactly match the key/secret pair you put in livekit.yaml.
LIVEKIT_API_KEY="REPLACE_WITH_YOUR_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_YOUR_SECRET"
