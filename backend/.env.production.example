# Copy this file to .env.production and fill in real values before deploying.
# docker-compose.prod.yml reads POSTGRES_PASSWORD directly; everything else
# is passed straight through to the backend container via env_file.

POSTGRES_PASSWORD="replace-with-a-long-random-password"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3010
GEOFENCE_CHECK_ENABLED=true

# Must be wss:// (not ws://) once behind Caddy's TLS termination.
LIVEKIT_URL="wss://livekit.yourdomain.com"
# These two MUST exactly match the key/secret pair you put in livekit.yaml.
LIVEKIT_API_KEY="REPLACE_WITH_YOUR_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_YOUR_SECRET"
